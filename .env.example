# ── SUPABASE ──────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key

# ── LLM ПРОВАЙДЕРЫ (utils/llm.py) ─────────────────
GROQ_API_KEY=your-groq-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GOOGLE_API_KEY=your-google-api-key

# ── TELEGRAM ──────────────────────────────────────
# Без TELEGRAM_BOT_TOKEN Telegram-интеграция выключена (бэкенд работает без неё).
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
# Username бота (без @) — нужен, чтобы собрать ссылку привязки клиента
# t.me/<username>?start=<token>. Без него API вернёт пустой deep_link.
TELEGRAM_BOT_USERNAME=your_bot_username
# Telegram chat_id нутрициолога. Двусторонний канал: входящие от него агент обрабатывает
# как в вебе (аналитика/управление), а сюда же шлёт критичные алерты по клиентам
# (high/critical + bad_wellbeing). Без него Telegram-канал нутрициолога и пуш алертов выключены.
NUTRITIONIST_TELEGRAM_ID=your-telegram-chat-id
# Полный публичный URL маршрута вебхука. Если задан — приложение само ставит setWebhook
# при старте (вручную дёргать не нужно). На проде:
#   https://nutritionist-agent-gvxp.onrender.com/telegram/webhook
TELEGRAM_WEBHOOK_URL=https://your-backend-host/telegram/webhook
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token (рекомендуется).
# Сгенерировать: openssl rand -hex 16
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
# Turn-буфер входящих (Фаза 2): окно debounce в секундах — серия сообщений/альбом
# склеиваются в один «ход» после паузы. По умолчанию 7. Значение 0 — буфер ВЫКЛ
# (сообщение обрабатывается сразу, старое поведение).
TELEGRAM_TURN_DEBOUNCE_SEC=7
# Планировщик уведомлений (APScheduler, api/scheduler.py): 1/true/yes — вкл (по умолчанию), 0 — выкл.
NOTIFICATIONS_ENABLED=1

# ── OPENAI (Whisper для голоса) ────────────────────
OPENAI_API_KEY=your-openai-api-key

# ── ВЕБ-ПОИСК ─────────────────────────────────────
# Веб-поиск идёт через серверный инструмент Claude web_search (ключ не нужен).
# Включается в Claude Console (Settings → Privacy) на уровне организации.

# ── МОНИТОРИНГ ────────────────────────────────────
LANGFUSE_PUBLIC_KEY=your-langfuse-public-key
LANGFUSE_SECRET_KEY=your-langfuse-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# ── ПРИЛОЖЕНИЕ ────────────────────────────────────
ENVIRONMENT=development
# CORS: список разрешённых origin фронта через запятую (FastAPI). Локально — Vite :5173;
# на проде — URL фронта (https://nutritionist-agent-1-ljzi.onrender.com).
CORS_ORIGINS=http://localhost:5173